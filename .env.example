# ===========================================
# PAYER UNIVERSE - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it contains secrets!)

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development
# Options: development, production

# ===========================================
# GOOGLE SHEETS API
# ===========================================
# Your Google Sheet ID (from the URL)
# Example: If your sheet URL is https://docs.google.com/spreadsheets/d/1ABC123xyz/edit
# Then your SHEET_ID is: 1ABC123xyz
GOOGLE_SHEET_ID=your_sheet_id_here

# Path to your Google service account credentials JSON file
# For local development, put the file in the project root
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# ===========================================
# APOLLO.IO API (Optional - for contact enrichment)
# ===========================================
APOLLO_API_KEY=your_apollo_api_key_here

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# For local development:
DATABASE_URL=postgresql://localhost:5432/payer_universe

# For Railway (they provide this automatically):
# DATABASE_URL=postgresql://user:password@host:port/database

# ===========================================
# CMS DATA SOURCES
# ===========================================
# These are public URLs - no API keys needed
# Listed here for reference and easy updating

# CMS Machine-Readable PUF (Public Use Files)
CMS_MARKET_DATA_URL=https://www.cms.gov/marketplace

# NAIC (National Association of Insurance Commissioners)
NAIC_DATA_URL=https://content.naic.org/

# ===========================================
# SYNC SETTINGS
# ===========================================
# How many rows to process at once (lower = slower but safer)
BATCH_SIZE=100

# Delay between API calls in milliseconds (to avoid rate limits)
API_DELAY_MS=1000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
# Options: debug, info, warn, error
